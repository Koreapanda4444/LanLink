{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "lanlink",
  "version-string": "0.7.0",
  "builtin-baseline": "a1cae005c39be7b18ba319fced856b68d7276271",
  "dependencies": [
    {
      "name": "imgui",
      "features": [
        "dx11-binding",
        "win32-binding"
      ],
      "platform": "windows"
    },
    "openssl",
    "sqlite3"
  ],
  "default-features": [
    "network-runtime"
  ],
  "features": {
    "network-runtime": {
      "description": "QUIC and TLS relay and client runtime",
      "dependencies": [
        "msquic"
      ]
    },
    "portable-desktop": {
      "description": "SDL3/OpenGL desktop for Linux and macOS",
      "supports": "!windows",
      "dependencies": [
        {
          "name": "imgui",
          "features": [
            "sdl3-binding",
            "opengl3-binding"
          ]
        },
        "sdl3",
        "libpng"
      ]
    }
  }
}
