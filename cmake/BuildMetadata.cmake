file(READ "${CMAKE_CURRENT_SOURCE_DIR}/vcpkg.json" LANLINK_DEPENDENCY_MANIFEST)
string(JSON LANLINK_MANIFEST_VERSION GET "${LANLINK_DEPENDENCY_MANIFEST}" version-string)
if(NOT LANLINK_MANIFEST_VERSION STREQUAL PROJECT_VERSION)
    message(FATAL_ERROR "CMake and dependency manifest versions must match")
endif()
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/include/lanlink/protocol/message.hpp" LANLINK_PROTOCOL_HEADER)
string(REGEX MATCH "protocol_version = ([0-9]+)" LANLINK_PROTOCOL_MATCH "${LANLINK_PROTOCOL_HEADER}")
set(LANLINK_PROTOCOL_VERSION "${CMAKE_MATCH_1}")
if(NOT LANLINK_PROTOCOL_MATCH)
    message(FATAL_ERROR "Protocol version is missing")
endif()
set(LANLINK_SOURCE_REVISION "unknown")
set(LANLINK_SOURCE_CLEAN false)
find_package(Git QUIET)
if(Git_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
        WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
        OUTPUT_VARIABLE LANLINK_SOURCE_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE LANLINK_REVISION_RESULT ERROR_QUIET)
    execute_process(COMMAND "${GIT_EXECUTABLE}" diff --quiet HEAD --
        WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
        RESULT_VARIABLE LANLINK_DIRTY_RESULT ERROR_QUIET)
    if(LANLINK_REVISION_RESULT EQUAL 0 AND LANLINK_DIRTY_RESULT EQUAL 0)
        set(LANLINK_SOURCE_CLEAN true)
    endif()
    if(NOT LANLINK_REVISION_RESULT EQUAL 0)
        set(LANLINK_SOURCE_REVISION "unknown")
    endif()
endif()
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" LANLINK_PACKAGE_ARCHITECTURE)
if(LANLINK_PACKAGE_ARCHITECTURE MATCHES "^(amd64|x86_64)$")
    set(LANLINK_PACKAGE_ARCHITECTURE x64)
endif()
set(LANLINK_BUILD_DISTRIBUTION "${CMAKE_SYSTEM_NAME}")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND LANLINK_RELAY_PACKAGE_PLATFORM)
    set(LANLINK_BUILD_DISTRIBUTION "${LANLINK_RELAY_PACKAGE_PLATFORM}")
endif()
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/release/build-info.json.in"
    "${CMAKE_CURRENT_BINARY_DIR}/build-info.json" @ONLY)
