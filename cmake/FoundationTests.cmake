find_package(Python3 REQUIRED COMPONENTS Interpreter)
add_test(NAME lanlink-release-assets
    COMMAND ${Python3_EXECUTABLE} ${PROJECT_SOURCE_DIR}/tests/release_assets_tests.py)

function(lanlink_foundation_test name)
    add_executable(lanlink_${name}_tests "${PROJECT_SOURCE_DIR}/tests/${name}_tests.cpp")
    target_link_libraries(lanlink_${name}_tests PRIVATE ${ARGN})
    lanlink_enable_warnings(lanlink_${name}_tests)
    string(REPLACE "_" "-" test_name "${name}")
    add_test(NAME lanlink-${test_name} COMMAND lanlink_${name}_tests)
endfunction()

lanlink_foundation_test(core lanlink_core)
