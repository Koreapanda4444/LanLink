    <key>ThrottleInterval</key><integer>2</integer>
    <key>ExitTimeOut</key><integer>25</integer>
    <key>UserName</key><string>root</string>
    <key>GroupName</key><string>wheel</string>
    <key>Umask</key><integer>63</integer>
</dict></plist>
